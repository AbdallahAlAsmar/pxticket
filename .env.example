# PX Ticket Dashboard (Vercel)

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SECRET=
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Public site URL
AUTH_URL=https://pxticket.vercel.app
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://pxticket.vercel.app

# IMPORTANT: bot-hosting port 21024 is plain HTTP (no TLS).
# Using https:// here causes "fetch failed".
BOT_API_URL=http://fi7.bot-hosting.net:21024/ticket-api
BOT_API_SECRET=same_secret_as_ticket_bot_DASHBOARD_API_SECRET
